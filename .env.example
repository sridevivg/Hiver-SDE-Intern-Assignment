# =============================================================================
# SupportGraph AI — Root Environment Variables Example
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# Data Paths
# ---------------------------------------------------------------------------
# Absolute or relative path to the directory containing the raw dataset CSV.
# Default points to the manually downloaded Kaggle dataset location.
DATA_RAW_DIR=Dataset/Raw/twcs

# Output directories (relative to project root)
DATA_INTERIM_DIR=data/interim
DATA_PROCESSED_DIR=data/processed
DATA_GOLDEN_DIR=data/golden

ARTIFACTS_DIR=artifacts

# ---------------------------------------------------------------------------
# Backend API
# ---------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# LLM Provider Configuration ("groq" or "ollama")
# ---------------------------------------------------------------------------
LLM_PROVIDER=groq

# Groq API Configuration
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Ollama Local Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
